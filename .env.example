# Django Core Settings
DJANGO_SETTINGS_MODULE=hrm_project.settings.<local_or_production>
SECRET_KEY=<your_secret_key>
DEBUG=<True_or_False>
ALLOWED_HOSTS=<host1,host2,host3>

# Database (Docker / Prod)
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>

# Local DB fallback (non-Docker)
DB_NAME=<db_name>
DB_USER=<db_user>
DB_PASSWORD=<db_password>
DB_HOST=<db_host>
DB_PORT=<db_port>

# Biometric Device
BIOMETRIC_DEVICE_IP=<device_ip>
BIOMETRIC_DEVICE_PORT=<device_port>
BIOMETRIC_DEVICE_PASSWORD=<device_password>
BIOMETRIC_DEVICE_TIMEOUT=<timeout_seconds>

# Celery / Redis
CELERY_BROKER_URL=redis://<redis_host>:6379/0
CELERY_RESULT_BACKEND=redis://<redis_host>:6379/0

ATTENDANCE_SYNC_INTERVAL=<sync_interval_seconds>

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=<smtp_host>
EMAIL_PORT=<smtp_port>
EMAIL_USE_TLS=<True_or_False>
EMAIL_HOST_USER=<email_username>
EMAIL_HOST_PASSWORD=<email_password>